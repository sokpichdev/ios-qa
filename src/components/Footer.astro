---
// src/components/Footer.astro
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const links = [
  { href: '/browse',     label: 'Browse' },
  { href: '/quiz',       label: 'Quiz' },
  { href: '/spin',       label: 'Spin' },
  { href: '/bookmarks',  label: 'Bookmarks' },
  { href: '/contribute', label: 'Contribute' },
];
---
<footer>
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href={`${base}/`}>ios-qa</a>
      <p>Community iOS development Q&amp;A — built by developers, for developers.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {links.map(l => <a href={`${base}${l.href}`}>{l.label}</a>)}
      <a href="https://github.com/Sok-Pich/ios-qa" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </div>
  <div class="container footer-meta">
    <span>© {year} ios-qa</span>
    <span>Built with Astro · Crafted with <span class="heart">♥</span></span>
  </div>
</footer>

<style>
footer {
  border-top: 1px solid var(--glass-border);
  background: rgba(13, 15, 20, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 40px 0 28px;
  margin-top: 48px;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 32px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}
.brand {
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 17px;
  color: var(--accent);
  text-decoration: none;
}
.footer-brand p {
  margin-top: 8px;
  font-size: 13px;
  color: var(--text-muted);
  max-width: 320px;
  line-height: 1.6;
}
.footer-links {
  display: flex;
  gap: 6px 20px;
  flex-wrap: wrap;
  align-items: start;
}
.footer-links a {
  font-size: 13px;
  color: var(--text-muted);
  text-decoration: none;
  transition: color var(--dur-fast);
  padding: 4px 0;
}
.footer-links a:hover { color: var(--accent); }
.footer-meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 12px;
  color: var(--text-muted);
  border-top: 1px solid var(--glass-border);
  padding-top: 20px;
}
.heart { color: var(--accent); }

@media (max-width: 640px) {
  footer { padding-bottom: 16px; }
}
</style>
