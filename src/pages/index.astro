---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { parseQuestionsFromRaw, CATEGORY_META, CATEGORIES } from '../lib/questions';
import type { IconName } from '../lib/icons';

const allFiles = import.meta.glob<string>(
  '../content/questions/**/*.md',
  { eager: true, query: '?raw', import: 'default' }
);

const allQuestions = Object.entries(allFiles).flatMap(([path, raw]) => {
  const match = path.match(/questions\/([^/]+)\//);
  const category = match?.[1] ?? 'swift';
  return parseQuestionsFromRaw(raw, category);
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const totalQuestions = allQuestions.length;

const categoryCounts = CATEGORIES.reduce((acc, cat) => {
  acc[cat] = allQuestions.filter(q => q.category === cat).length;
  return acc;
}, {} as Record<string, number>);

function hexToRgb(hex: string): string {
  const n = parseInt(hex.slice(1), 16);
  return `${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}`;
}

const stats: { icon: IconName; value: number; label: string }[] = [
  { icon: 'message-circle', value: totalQuestions, label: 'Questions' },
  { icon: 'folder', value: CATEGORIES.length, label: 'Categories' },
  { icon: 'zap', value: 3, label: 'Difficulty Levels' },
];
---
<BaseLayout title="ios-qa" description="Community iOS development Q&A — browse, quiz, and contribute">
  <div class="hero">
    <span class="float-symbol fs-1" aria-hidden="true">{'{ }'}</span>
    <span class="float-symbol fs-2" aria-hidden="true">func</span>
    <span class="float-symbol fs-3" aria-hidden="true">→</span>
    <span class="float-symbol fs-4" aria-hidden="true">@State</span>
    <h1 class="fade-up">ios-qa</h1>
    <p class="subtitle fade-up delay-1">Community iOS development Q&amp;A — Swift, SwiftUI, Concurrency, Architecture &amp; more.</p>
    <div class="hero-actions fade-up delay-2">
      <a href={`${base}/browse`} class="btn btn-primary hero-btn">Browse Questions →</a>
      <a href={`${base}/contribute`} class="btn btn-ghost hero-btn">Contribute</a>
    </div>
    <div class="scroll-hint fade-up delay-3" aria-hidden="true">↓ scroll to explore</div>
  </div>

  <div class="stats-row">
    {stats.map(s => (
      <div class="stat-card card">
        <div class="stat-icon"><Icon name={s.icon} size={24} /></div>
        <div class="stat-num" data-target={s.value}>{s.value}</div>
        <div class="stat-label">{s.label}</div>
      </div>
    ))}
  </div>

  <section class="home-section">
    <h2 class="section-heading">Categories</h2>
    <div class="category-grid">
      {CATEGORIES.map((cat, i) => {
        const meta = CATEGORY_META[cat];
        return (
          <a
            href={`${base}/browse?category=${cat}`}
            class="category-card card fade-up"
            style={`--cat-color: ${meta.color}; --cat-rgb: ${hexToRgb(meta.color)}; animation-delay: ${i * 50}ms;`}
          >
            <span class="cat-icon"><Icon name={meta.icon} size={26} /></span>
            <div>
              <div class="cat-label">{meta.label}</div>
              <span class="cat-count">{categoryCounts[cat] ?? 0} questions</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="home-section">
    <h2 class="section-heading">Study Tools</h2>
    <div class="tools-grid">
      <a href={`${base}/quiz`} class="tool-card card">
        <span class="tool-icon"><Icon name="help-circle" size={36} /></span>
        <div>
          <strong>Quiz Mode</strong>
          <p>Test yourself with randomized questions</p>
        </div>
      </a>
      <a href={`${base}/spin`} class="tool-card card">
        <span class="tool-icon"><Icon name="disc" size={36} /></span>
        <div>
          <strong>Spin Wheel</strong>
          <p>Random category challenge</p>
        </div>
      </a>
      <a href={`${base}/bookmarks`} class="tool-card card">
        <span class="tool-icon"><Icon name="bookmark" size={36} /></span>
        <div>
          <strong>Bookmarks</strong>
          <p>Review your saved questions</p>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Animated count-up for stat numbers on first scroll into view.
  // Runs on astro:page-load so it re-arms after view-transition navigations.
  document.addEventListener('astro:page-load', () => {
    const nums = document.querySelectorAll<HTMLElement>('.stat-num');
    if (!nums.length) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.target ?? '0');
        const start = performance.now();
        const duration = 800;
        function tick(now: number) {
          const t = Math.min((now - start) / duration, 1);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        }
        el.textContent = '0';
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.4 });
    nums.forEach(el => observer.observe(el));
  });
</script>

<style>
.hero { position: relative; text-align: center; padding: 80px 0 64px; }
.hero h1 {
  position: relative;
  font-size: clamp(40px, 6vw, 72px);
  font-weight: 700;
  font-family: var(--font-mono);
  background: linear-gradient(135deg, #f05a28, #ff7a50, #fbbf24, #ff7a50, #f05a28);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: shimmer 6s ease-in-out infinite;
}
@keyframes shimmer {
  0%, 100% { background-position: 0% 50%; }
  50%      { background-position: 100% 50%; }
}
.hero h1::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 340px;
  height: 180px;
  background: radial-gradient(closest-side, rgba(240, 90, 40, 0.22), transparent);
  filter: blur(30px);
  z-index: -1;
  pointer-events: none;
}

/* Floating decorative code symbols */
.float-symbol {
  position: absolute;
  font-family: var(--font-mono);
  color: var(--accent);
  opacity: 0.12;
  filter: blur(1px);
  pointer-events: none;
  user-select: none;
  animation: float-drift 14s ease-in-out infinite;
}
.fs-1 { top: 14%; left: 8%;  font-size: 34px; }
.fs-2 { top: 60%; left: 14%; font-size: 22px; color: #7c3aed; animation-delay: -4s; }
.fs-3 { top: 22%; right: 12%; font-size: 38px; color: #fbbf24; animation-delay: -8s; }
.fs-4 { top: 66%; right: 9%;  font-size: 20px; color: #0ea5e9; animation-delay: -11s; }
@keyframes float-drift {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33%      { transform: translate(8px, -14px) rotate(4deg); }
  66%      { transform: translate(-6px, 10px) rotate(-4deg); }
}

.subtitle {
  font-size: 20px; color: var(--text-muted); line-height: 1.6;
  margin: 16px auto 36px; max-width: 600px;
}
.hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.hero-btn { padding: 12px 28px; font-size: 15px; }

.scroll-hint {
  margin-top: 48px;
  font-size: 13px;
  color: var(--text-muted);
  animation: hint-bob 2s ease-in-out infinite;
}
@keyframes hint-bob {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50%      { transform: translateY(6px); opacity: 1; }
}

.stats-row {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 16px; margin-bottom: 8px;
}
.stat-card {
  text-align: center; padding: 24px;
  border-top: 3px solid var(--accent);
}
.stat-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--glow-accent-soft);
}
.stat-icon { color: var(--accent); margin-bottom: 8px; display: flex; justify-content: center; }
.stat-num {
  font-size: 40px; font-weight: 700;
  color: var(--accent); font-family: var(--font-mono);
}
.stat-label { font-size: 14px; color: var(--text-muted); margin-top: 4px; }

.home-section { padding: 80px 0 0; }
.section-heading { margin-bottom: 24px; }

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
}
.category-card {
  display: flex; align-items: center; gap: 12px;
  text-decoration: none; color: var(--text);
  border-left: 4px solid var(--cat-color);
}
.category-card:hover {
  background: rgba(var(--cat-rgb), 0.08);
  border-color: var(--cat-color);
  box-shadow: 0 0 16px rgba(var(--cat-rgb), 0.2);
  text-decoration: none;
}
.cat-icon {
  display: flex;
  color: var(--cat-color);
  filter: drop-shadow(0 0 8px var(--cat-color));
  flex-shrink: 0;
}
.cat-label { font-weight: 600; }
.cat-count {
  display: inline-block;
  margin-top: 4px;
  font-size: 12px;
  font-weight: 500;
  color: var(--cat-color);
  background: rgba(var(--cat-rgb), 0.12);
  border-radius: 12px;
  padding: 1px 9px;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
}
.tool-card {
  display: flex; align-items: center; gap: 16px;
  padding: 24px 20px;
  text-decoration: none; color: var(--text);
}
.tool-card:hover {
  background: linear-gradient(135deg, var(--glass-hover), rgba(40, 44, 62, 0.7));
  text-decoration: none;
}
.tool-icon {
  position: relative;
  display: flex; flex-shrink: 0;
  color: var(--accent);
  z-index: 0;
}
.tool-icon::before {
  content: '';
  position: absolute;
  inset: -10px;
  background: radial-gradient(closest-side, rgba(240, 90, 40, 0.18), transparent);
  z-index: -1;
  border-radius: 50%;
}
.tool-card:hover .tool-icon { animation: bounce-subtle 0.5s ease; }
@keyframes bounce-subtle {
  0%, 100% { transform: translateY(0); }
  40%      { transform: translateY(-7px); }
  70%      { transform: translateY(2px); }
}
.tool-card strong { display: block; margin-bottom: 4px; }
.tool-card p { font-size: 13px; color: var(--text-muted); margin: 0; }

@media (max-width: 640px) {
  .stats-row { grid-template-columns: 1fr; }
  .hero { padding: 48px 0 40px; }
  .home-section { padding: 56px 0 0; }
  .scroll-hint { margin-top: 32px; }
  .float-symbol { display: none; }
}
</style>
