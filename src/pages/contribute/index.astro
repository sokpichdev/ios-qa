---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContributeForm from '../../components/ContributeForm';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Contribute" description="Submit a new iOS Q&A question to ios-qa">
  <div style="max-width: 960px;">
    <div style="margin-bottom: 32px;">
      <h1 style="font-size: 28px; margin-bottom: 8px;">Contribute a Question</h1>
      <p style="color: var(--text-muted); line-height: 1.6;">
        Fill in the form — it opens GitHub with your question pre-filled as a new file.
        After committing, open a Pull Request and it'll be reviewed.
        Prefer working in git? <a href={`${base}/contribute/guide`}>See the contributor guide →</a>
      </p>
    </div>
    <ContributeForm client:load />
  </div>
</BaseLayout>
