---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseQuestionsFromRaw, CATEGORY_META } from '../../lib/questions';

export async function getStaticPaths() {
  const allFiles = import.meta.glob<string>(
    '../../content/questions/**/*.md',
    { eager: true, query: '?raw', import: 'default' }
  );

  const allQuestions = Object.entries(allFiles).flatMap(([path, raw]) => {
    const match = path.match(/questions\/([^/]+)\//);
    const category = match?.[1] ?? 'swift';
    return parseQuestionsFromRaw(raw, category);
  });

  return allQuestions.map(q => ({
    params: { id: q.id },
    props: { question: q },
  }));
}

const { question: q } = Astro.props;
const meta = CATEGORY_META[q.category];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={q.title} description={`${meta.label} · ${q.difficulty}`}>
  <div data-pagefind-body>
    <nav style="margin-bottom: 16px; display: flex; gap: 8px; align-items: center; font-size: 14px;">
      <a href={`${base}/browse`} style="color: var(--text-muted);">← Browse</a>
      <span style="color: var(--border)">|</span>
      <span style="color: var(--text-muted)">{meta.emoji} {meta.label}</span>
      <span style="color: var(--border)">|</span>
      <span style={`color: ${q.difficulty === 'Beginner' ? '#10b981' : q.difficulty === 'Advanced' ? '#ef4444' : '#f59e0b'}`}>
        {q.difficulty}
      </span>
    </nav>

    <h1 style="font-size: 22px; margin-bottom: 24px; line-height: 1.4;">{q.title}</h1>

    <div class="answer-body" style="line-height: 1.7; white-space: pre-wrap;">{q.body}</div>

    <div style="margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--border);">
      <a href={`${base}/browse`} class="btn btn-ghost" style="font-size: 13px;">← Back to Browse</a>
    </div>
  </div>
</BaseLayout>
